<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Docker Security — Scene-by-Scene SVG Walkthrough</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f5f7;--ink:#1f2023;--mute:#6b7078;--line:#e4e6ea;--card:#fff;--accent:#12906f;--track:#e6e8eb}
*{box-sizing:border-box;min-width:0}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 Inter,system-ui,-apple-system,Segoe UI,sans-serif;-webkit-font-smoothing:antialiased}
main{max-width:1040px;margin:0 auto;padding:34px 18px 40px}
.head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:20px}
h1{font-size:32px;line-height:1.15;font-weight:700;letter-spacing:-.02em;margin:0 0 10px}
.head p{margin:0;color:var(--mute);font-size:15px}
.count{color:var(--mute);font-size:15px;font-variant-numeric:tabular-nums;white-space:nowrap}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:0 1px 2px rgba(0,0,0,.03),0 8px 24px -12px rgba(0,0,0,.08);padding:14px 22px 22px}
.view{position:relative;aspect-ratio:920/690;width:min(100%,calc(70vh * 920 / 690));margin:0 auto}
.view svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.cap{font-weight:700;font-size:19px;margin:14px 0 0}
.prog{height:5px;background:var(--track);border-radius:99px;margin:18px 0 20px;overflow:hidden}
.prog i{display:block;height:100%;background:var(--accent);border-radius:99px;width:0;transition:width .4s ease}
nav{display:flex;gap:10px;align-items:center}
nav .sp{flex:1}
button{font:500 16px Inter,system-ui,sans-serif;height:46px;padding:0 17px;border-radius:10px;border:1px solid var(--line);background:#fff;color:var(--ink);cursor:pointer}
button:disabled{background:#f8f8f9;color:#a3a6ab;cursor:default}
button.pri{background:#212225;border-color:#212225;color:#fff}
button.pri:disabled{background:#c9cbcf;border-color:#c9cbcf;color:#fff}
button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.help{color:var(--mute);font-size:13px;margin:16px 4px 0}
@media(max-width:600px){main{padding-top:24px}h1{font-size:28px}.card{padding:10px 12px 16px}.cap{font-size:17px}nav{flex-wrap:wrap}nav .sp{display:none}nav button{flex:1 1 40%}}
@media(prefers-reduced-motion:reduce){.prog i{transition:none}}
</style></head><body>
